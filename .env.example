# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/news_aggregator

# Gemini AI Configuration (REQUIRED for article importance scoring)
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Substack Configuration
SUBSTACK_API_KEY=your_substack_api_key
SUBSTACK_PUBLICATION_URL=https://yourpublication.substack.com

# Optional: OpenAI for better classification (can work without it)
OPENAI_API_KEY=your_openai_api_key_optional

# Environment
NODE_ENV=production
PORT=8080

# Newsletter Configuration
NEWSLETTER_FROM_NAME=Mongolian News Digest
NEWSLETTER_SUBJECT_PREFIX=Daily News Digest
BASE_URL=https://your-production-domain.com
